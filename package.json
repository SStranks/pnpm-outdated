{
  "name": "pnpm-outdated",
  "version": "1.0.0",
  "description": "github action - runs `pnpm outdated` on repository and prints output to github summary",
  "author": "Simon Stranks <sstranks0@gmail.com> <https://github.com/SStranks>",
  "repository": {
    "type": "github",
    "url": "https://github.com/SStranks/pnpm-outdated"
  },
  "keywords": [
    "actions",
    "node",
    "outdated",
    "version",
    "semver"
  ],
  "license": "ISC",
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=20 <24",
    "pnpm": ">=11"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "onFail": "error",
      "version": ">=20 <24"
    }
  },
  "prettier": "@packages/prettier-config",
  "main": "dist/main.js",
  "scripts": {
    "commitlint": "commitlint",
    "start": "node dist/main.js",
    "start:dev": "NODE_ENV=development node --import tsx apps/pnpm-outdated/src/main.ts",
    "build": "tsc ",
    "prepare": "husky",
    "lint": "eslint",
    "megalint": "docker run --rm -e MEGALINTER_CONFIG=.mega-linter.local.yaml -v \"$(pwd)\":/tmp/lint oxsecurity/megalinter:v8"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@packages/commitlint-config": "workspace:*",
    "@packages/eslint-config-global": "workspace:*",
    "@packages/eslint-config-javascript": "workspace:*",
    "@packages/eslint-config-typescript": "workspace:*",
    "@packages/eslint-config-yaml": "workspace:*",
    "@packages/prettier-config": "workspace:*",
    "@packages/typescript-config": "workspace:*",
    "semver": "^7.8.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@types/node": "^25.9.1",
    "@types/semver": "^7.7.1",
    "eslint": "^9.39.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "prettier": "^3.8.3",
    "tsx": "^4.22.0",
    "typescript": "^6.0.3"
  }
}
