{
  "extends": "./tsconfig.base.json",
  "include": ["src/**/*", "global.d.ts"],
  "exclude": ["node_modules", "dist", "src/**/private*.*", "src/**/private/*", "src/**/*.test.*", "src/**/*.spec.*"],
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "target": "ES2022",
    "module": "node16",
    "moduleResolution": "node16",
    "allowImportingTsExtensions": false,
    "outDir": "./dist",
    "rootDir": "./src",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "types": ["node", "semver"]
  }
}
